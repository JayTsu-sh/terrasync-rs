# terrasync-rs Harness Runner 配置
# 复制本文件为 .env，填写实际值（.env 不入库）

# === terrasync binary ===
TERRASYNC_BINARY=./target/debug/terrasync
TERRASYNC_CONFIG=examples/config.toml
SSH_USER=root

# === NFS v3 ===
NFS_V3_SOURCE_IP=192.168.50.173
NFS_V3_DEST_IP=192.168.50.23
NFS_V3_EXPORT=/export/nfs

# === NFS v4 ===
NFS_V4_SOURCE_IP=192.168.50.173
NFS_V4_DEST_IP=192.168.50.23
NFS_V4_EXPORT=/export/nfsv4

# === S3 / RustFS ===
S3_SOURCE_HOST=192.168.50.173:39000
S3_DEST_HOST=192.168.50.23:39000
S3_BUCKET_SRC=mbucket-src
S3_BUCKET_DST=mbucket-dst
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin123

# === CIFS / SMB (Samba) ===
CIFS_SOURCE_HOST=192.168.50.173
CIFS_DEST_HOST=192.168.50.23
CIFS_SHARE=testshare
CIFS_USER=terrasync
CIFS_PASS=terrasync123

# === CIFS / SMB 匿名共享 ===
CIFS_ANON_SOURCE_HOST=192.168.50.173
CIFS_ANON_DEST_HOST=192.168.50.23
CIFS_ANON_SHARE=share
CIFS_ANON_PORT=445

# === ClickHouse ===
CLICKHOUSE_HOST=192.168.50.173:8123
CLICKHOUSE_DATABASE=default

# === 报告输出目录（留空使用 $TMPDIR/terrasync-harness-results）===
HARNESS_OUTPUT_DIR=
